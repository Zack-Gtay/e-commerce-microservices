@page
@model Shopping.Web.Pages.CartModel
@{
    ViewData["Title"] = "Cart";
    var items = Model.Cart.Items;
    var itemCount = items.Sum(i => i.Quantity);
}

<div class="container">

    <nav aria-label="Breadcrumb">
        <ol class="crumbs">
            <li><a asp-page="/Index">Home</a></li>
            <li aria-current="page">Cart</li>
        </ol>
    </nav>

    <header class="page-head">
        <h1 class="page-head__title">Your cart</h1>
        <p class="page-head__meta">@itemCount @(itemCount == 1 ? "item" : "items")</p>
    </header>

    @if (!items.Any())
    {
        <div class="panel">
            <div class="empty">
                <span class="empty__icon">
                    <svg width="22" height="22" aria-hidden="true"><use href="#i-bag"/></svg>
                </span>
                <h2 class="empty__title">Your cart is empty</h2>
                <p class="empty__text">
                    Browse the catalog and add something you like and it will show up here.
                </p>
                <div class="empty__actions">
                    <a class="btn btn--primary" asp-page="/ProductList">
                        Start shopping
                        <svg width="16" height="16" aria-hidden="true"><use href="#i-arrow-right"/></svg>
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-12 col-lg-8">
                <div class="panel">
                    <div class="table-scroll">
                        <table class="data-table">
                            <caption class="sr-only">Items in your cart</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Product</th>
                                    <th scope="col">Colour</th>
                                    <th scope="col">Quantity</th>
                                    <th scope="col" class="num">Price</th>
                                    <th scope="col"><span class="sr-only">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in items)
                                {
                                    <tr>
                                        <td>
                                            <div class="cell-product">
                                                <span class="thumb d-grid" style="place-items:center;">
                                                    <svg width="18" height="18" aria-hidden="true" style="color:var(--fg-subtle)"><use href="#i-package"/></svg>
                                                </span>
                                                <span>
                                                    <span class="cell-product__name">@item.ProductName</span><br />
                                                    <span class="cell-product__meta">@item.Price.ToMoney() each</span>
                                                </span>
                                            </div>
                                        </td>
                                        <td class="muted">@item.Color</td>
                                        <td>
                                            <form asp-page-handler="UpdateQuantity" method="post" class="cluster" style="gap:var(--s-2)">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <div class="stepper" data-stepper>
                                                    <button class="stepper__btn" type="button" data-stepper-dec aria-label="Decrease quantity of @item.ProductName">
                                                        <svg width="14" height="14" aria-hidden="true"><use href="#i-minus"/></svg>
                                                    </button>
                                                    <input class="stepper__input" data-stepper-input type="number"
                                                           name="quantity" value="@item.Quantity" min="1" max="99"
                                                           aria-label="Quantity of @item.ProductName" />
                                                    <button class="stepper__btn" type="button" data-stepper-inc aria-label="Increase quantity of @item.ProductName">
                                                        <svg width="14" height="14" aria-hidden="true"><use href="#i-plus"/></svg>
                                                    </button>
                                                </div>
                                                <button type="submit" class="btn btn--ghost btn--sm">Update</button>
                                            </form>
                                        </td>
                                        <td class="num fw-550">@((item.Price * item.Quantity).ToMoney())</td>
                                        <td class="num">
                                            <form asp-page-handler="RemoveToCart" method="post" class="form-inline-reset">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="submit" class="btn btn--danger btn--sm" title="Remove @item.ProductName">
                                                    <svg width="15" height="15" aria-hidden="true"><use href="#i-trash"/></svg>
                                                    <span class="sr-only">Remove @item.ProductName</span>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="cluster" style="margin-top:var(--s-5)">
                    <a class="btn btn--secondary" asp-page="/ProductList">Continue shopping</a>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="panel">
                    <div class="panel__head">
                        <h2 class="panel__title">Order summary</h2>
                    </div>
                    <div class="panel__body">
                        <div class="summary-row">
                            <span>Subtotal</span>
                            <span>@Model.Cart.TotalPrice.ToMoney()</span>
                        </div>
                        <div class="summary-row">
                            <span>Shipping</span>
                            <span>Free</span>
                        </div>
                        <div class="summary-row summary-row--total">
                            <span>Total</span>
                            <span>@Model.Cart.TotalPrice.ToMoney()</span>
                        </div>
                    </div>
                    <div class="panel__foot">
                        <a class="btn btn--primary btn--lg btn--block" asp-page="/Checkout">
                            Checkout
                            <svg width="16" height="16" aria-hidden="true"><use href="#i-arrow-right"/></svg>
                        </a>
                        <p class="t-xs subtle" style="margin-top:var(--s-3); text-align:center;">
                            Taxes calculated at checkout
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }

</div>
