@inject IBasketService BasketService
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "/Index";

    var cartCount = 0;
    try
    {
        var headerBasket = await BasketService.LoadUserBasket();
        cartCount = headerBasket.Items.Sum(i => i.Quantity);
    }
    catch
    {
        cartCount = 0;
    }

    string NavClass(string page) =>
        currentPage.Equals(page, StringComparison.OrdinalIgnoreCase)
            ? "site-nav__link is-active"
            : "site-nav__link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Nexus, a consumer electronics storefront built on a .NET 8 microservices backend." />
    <meta name="theme-color" content="#fcfcfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0d11" media="(prefers-color-scheme: dark)" />
    <title>@ViewData["Title"] · Nexus</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
        <symbol id="i-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></symbol>
        <symbol id="i-cart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></symbol>
        <symbol id="i-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></symbol>
        <symbol id="i-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m3 0v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6"/></symbol>
        <symbol id="i-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></symbol>
        <symbol id="i-minus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/></symbol>
        <symbol id="i-truck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9m10 0h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></symbol>
        <symbol id="i-shield" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></symbol>
        <symbol id="i-rotate" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></symbol>
        <symbol id="i-arrow-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></symbol>
        <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></symbol>
        <symbol id="i-alert" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></symbol>
        <symbol id="i-package" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></symbol>
        <symbol id="i-bag" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18M16 10a4 4 0 0 1-8 0"/></symbol>
        <symbol id="i-mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></symbol>
        <symbol id="i-github" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"/></symbol>
    </svg>

    <header class="site-header">
        <div class="container">
            <div class="site-header__inner">
                <a class="brand" asp-page="/Index">
                    <span class="brand__mark" aria-hidden="true">N</span>
                    Nexus
                </a>

                <nav class="d-none d-md-block" aria-label="Main">
                    <ul class="site-nav">
                        <li><a class="@NavClass("/Index")" asp-page="/Index">Home</a></li>
                        <li><a class="@NavClass("/ProductList")" asp-page="/ProductList">Shop</a></li>
                        <li><a class="@NavClass("/OrderList")" asp-page="/OrderList">Orders</a></li>
                        <li><a class="@NavClass("/Contact")" asp-page="/Contact">Contact</a></li>
                    </ul>
                </nav>

                <div class="header-actions">
                    <form class="search" asp-page="/ProductList" method="get" role="search">
                        <label class="sr-only" for="site-search">Search products</label>
                        <span class="search__icon"><svg width="15" height="15" aria-hidden="true"><use href="#i-search"/></svg></span>
                        <input class="search__input" type="search" id="site-search" name="q" placeholder="Search products" />
                    </form>

                    <a class="cart-button" asp-page="/Cart">
                        <svg width="16" height="16" aria-hidden="true"><use href="#i-cart"/></svg>
                        <span class="d-none d-sm-inline">Cart</span>
                        <span class="cart-button__count" aria-hidden="true">@cartCount</span>
                        <span class="sr-only">@cartCount items in cart</span>
                    </a>

                    <button class="nav-toggle" type="button" data-bs-toggle="collapse"
                            data-bs-target="#mobileNav" aria-controls="mobileNav"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <svg width="18" height="18" aria-hidden="true"><use href="#i-menu"/></svg>
                    </button>
                </div>
            </div>
        </div>

        <div class="collapse d-md-none mobile-nav" id="mobileNav">
            <div class="container">
                <ul>
                    <li><a asp-page="/Index">Home</a></li>
                    <li><a asp-page="/ProductList">Shop</a></li>
                    <li><a asp-page="/OrderList">Orders</a></li>
                    <li><a asp-page="/Contact">Contact</a></li>
                </ul>
            </div>
        </div>
    </header>

    <main class="main" id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="site-footer__grid">
                <div>
                    <a class="brand" asp-page="/Index">
                        <span class="brand__mark" aria-hidden="true">N</span>
                        Nexus
                    </a>
                    <p class="site-footer__blurb">
                        A reference storefront for a .NET 8 microservices backend: catalog,
                        basket, discount and ordering services behind a YARP gateway.
                    </p>
                </div>

                <div>
                    <h2>Shop</h2>
                    <ul>
                        <li><a asp-page="/ProductList">All products</a></li>
                        <li><a asp-page="/ProductList" asp-route-categoryName="Smart Phone">Phones</a></li>
                        <li><a asp-page="/ProductList" asp-route-categoryName="Camera">Cameras</a></li>
                        <li><a asp-page="/ProductList" asp-route-categoryName="Home Kitchen">Home &amp; Kitchen</a></li>
                    </ul>
                </div>

                <div>
                    <h2>Account</h2>
                    <ul>
                        <li><a asp-page="/Cart">Cart</a></li>
                        <li><a asp-page="/OrderList">Order history</a></li>
                        <li><a asp-page="/Contact">Contact us</a></li>
                        <li><a asp-page="/Privacy">Privacy</a></li>
                    </ul>
                </div>

                <div>
                    <h2>Built with</h2>
                    <div class="tech-list">
                        <span class="tech-tag">.NET 8</span>
                        <span class="tech-tag">gRPC</span>
                        <span class="tech-tag">RabbitMQ</span>
                        <span class="tech-tag">Redis</span>
                        <span class="tech-tag">YARP</span>
                        <span class="tech-tag">Docker</span>
                    </div>
                </div>
            </div>

            <div class="site-footer__bottom">
                <span>&copy; @DateTime.Now.Year Nexus. A portfolio project.</span>
                <a class="cluster" href="https://github.com/Zack-Gtay/e-commerce-microservices" target="_blank" rel="noopener noreferrer">
                    <svg width="15" height="15" aria-hidden="true"><use href="#i-github"/></svg>
                    View source
                </a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
