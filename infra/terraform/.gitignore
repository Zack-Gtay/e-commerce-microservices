# Provider binaries and local state -- never committed.
.terraform/
*.tfstate
*.tfstate.*
crash.log

# Plan files are build artifacts; CI passes them between jobs as artifacts instead.
tfplan
plan.txt

# Real backend config and any local overrides (may contain account-specific values).
backend.hcl
*.auto.tfvars
override.tf
override.tf.json

# .terraform.lock.hcl IS committed on purpose: it pins provider checksums so CI and
# local runs resolve identical provider versions.
