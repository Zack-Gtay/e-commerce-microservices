# Copy to backend.hcl and pass with:
#   terraform init -backend-config=backend.hcl
#
# The bucket must exist before the first init -- it cannot be managed by the state it
# holds. Create it once, with versioning enabled so a corrupted state can be rolled back:
#
#   aws s3api create-bucket --bucket eshop-tfstate-<account-id> \
#     --region eu-west-1 --create-bucket-configuration LocationConstraint=eu-west-1
#   aws s3api put-bucket-versioning --bucket eshop-tfstate-<account-id> \
#     --versioning-configuration Status=Enabled
#
# Locking uses S3 conditional writes (use_lockfile, Terraform 1.10+), so no DynamoDB
# table is required.

bucket = "eshop-tfstate-000000000000"
region = "eu-west-1"
